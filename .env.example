# Copy this file to .env and fill in your real values.
# NEVER commit your real .env file to git or share it publicly.

PORT=3000

# Set to "sandbox" while testing, "live" only once JazzCash/Easypaisa have
# approved your merchant account and you've tested real sandbox transactions.
PAYMENT_MODE=sandbox

# Public base URL of this site (used to build gateway return/callback URLs).
# In sandbox/local testing this can stay as http://localhost:3000
BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# JazzCash (Hosted Checkout Page) — get these from your JazzCash merchant
# dashboard after your business account is approved.
# ---------------------------------------------------------------------------
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
# Sandbox: https://sandbox.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform/
# Live:    https://payments.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform/
JAZZCASH_HCP_URL=https://sandbox.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform/

# ---------------------------------------------------------------------------
# Easypaisa — field names/hash formula can differ slightly by the exact
# product Easypaisa signs you up for. CONFIRM against the integration PDF
# your Easypaisa relationship manager gives you before going live. See
# server/lib/easypaisa.js for where to adjust if needed.
# ---------------------------------------------------------------------------
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_HCP_URL=https://easypay.easypaisa.com.pk/easypay/Index.jsf

# ---------------------------------------------------------------------------
# Simple admin panel (view incoming orders at /admin.html)
# ---------------------------------------------------------------------------
ADMIN_TOKEN=change-this-to-a-secret-you-pick
